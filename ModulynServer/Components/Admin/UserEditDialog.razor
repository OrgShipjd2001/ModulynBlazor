@using Microsoft.AspNetCore.Identity
@using Modulyn.Server.Interface
@using ModulynServer.model
@using Modulyn.Server.Bl
@using Modulyn.Server.Bl.IdentityGroups
@using Microsoft.EntityFrameworkCore

@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject UserManager<ApplicationUser> _userManager
@inject RoleManager<IdentityRole> _roleManager
@inject ApplicationDbContext _db

<RadzenTemplateForm TItem="ApplicationUser" Data="@User" Submit="@HandleSubmit">
    <div class="rz-p-4">
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <div>
                <RadzenText Text="Username" />
                <RadzenTextBox @bind-Value="@User.UserName" Class="w-100" Name="Username" Required="true" />
                <RadzenRequiredValidator Component="Username" Text="Username is required" Popup="true" />
            </div>
            <div>
                <RadzenText Text="Email" />
                <RadzenTextBox @bind-Value="@User.Email" Class="w-100" Name="Email" Type="Email" Required="true" />
                <RadzenRequiredValidator Component="Email" Text="Email is required" Popup="true" />
                <RadzenEmailValidator Component="Email" Text="Invalid email format" Popup="true" />
            </div>
            @if (NewUser) // Only ask for password when adding new user
            {
                <div>
                    <RadzenText Text="Password" />
                    <RadzenTextBox @bind-Value="@password" Class="w-100" Name="Password" Type="Password" Required="true" />
                    <RadzenRequiredValidator Component="Password" Text="Password is required for new users" Popup="true" />
                </div>
            }
            <div>
                <RadzenText Text="Role" />
                <RadzenDropDown TValue="string" @bind-Value="@userRole" Data="@availaleRoleNames"
                                Class="w-100" Name="Role" AllowClear="false" />
            </div>
            <div>
                <RadzenText Text="User Groups" />
                <RadzenDropDown TValue="IEnumerable<string>" @bind-Value="@selectedGroups" Data="@availableGroupNames"
                                Class="w-100" Name="UserGroups" Multiple="true" AllowClear="true" Placeholder="(none)" />
            </div>
        </RadzenStack>
    </div>
    <div class="rz-p-4 rz-pt-0 d-flex justify-content-end">
        <RadzenButton ButtonType="ButtonType.Submit" Text="@(string.IsNullOrEmpty(User.Id) ? "Add User" : "Save Changes")" Icon="save" ButtonStyle="ButtonStyle.Primary" Class="rz-mr-2" />
        <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
    </div>
</RadzenTemplateForm>

@code {
    [Parameter]
    public ApplicationUser User { get; set; } = new ApplicationUser();

    [Parameter]
    public bool NewUser { get; set; } = true;

    [Parameter]
    public List<string> AvailableGroupNames { get; set; } = new();

    private string password;
    private string userRole;
    private IEnumerable<string> selectedGroups = Array.Empty<string>();
    private List<string> availaleRoleNames = new List<string>();
    private List<string> availableGroupNames = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        foreach(IdentityRole role in _roleManager.Roles)
        {
            availaleRoleNames.Add(role.Name);
        }

        availableGroupNames = (AvailableGroupNames ?? new List<string>()).ToList();
        if (availableGroupNames.Count == 0)
        {
            availableGroupNames = await _db.Groups
                .OrderBy(g => g.Name)
                .Select(g => g.Name)
                .ToListAsync();
        }

        IList<string> userRoles = await _userManager.GetRolesAsync(User);
        userRole = userRoles.FirstOrDefault() ?? ModulynAuthRole.User.ToString(); // Default to "User" if no roles assigned)

        // Load current group membership (single-select UI: first group wins)
        if (!string.IsNullOrWhiteSpace(User.Id))
        {
            var existingGroups = await _db.UserGroups
                .Where(ug => ug.UserId == User.Id)
                .Select(ug => ug.Group.Name)
                .OrderBy(n => n)
                .ToListAsync();

            selectedGroups = existingGroups;
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (NewUser)
            {
                var createResult = await _userManager.CreateAsync(User, password);
                if (!createResult.Succeeded)
                {
                    var reason = string.Join("; ", createResult.Errors.Select(e => e.Description));
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = reason });
                    return;
                }
            }
            else
            {
                // Update existing user
                var updateResult = await _userManager.UpdateAsync(User);
                if (!updateResult.Succeeded)
                {
                    var reason = string.Join("; ", updateResult.Errors.Select(e => e.Description));
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = reason });
                    return;
                }
            }

            bool roleAlreadyAssigned = false;
            foreach(string roleName in await _userManager.GetRolesAsync(User))
            {
                if (!roleName.Equals(userRole))
                    await _userManager.RemoveFromRoleAsync(User, roleName);
                else
                    roleAlreadyAssigned = true;
            }

            if (!roleAlreadyAssigned)
            {
                var addRoleResult = await _userManager.AddToRoleAsync(User, userRole);
                if (!addRoleResult.Succeeded)
                {
                    var reason = string.Join("; ", addRoleResult.Errors.Select(e => e.Description));
                    NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = reason });
                    return;
                }
            }

            // Persist group membership (single-selected group)
            if (!string.IsNullOrWhiteSpace(User.Id))
            {
                var existing = await _db.UserGroups.Where(ug => ug.UserId == User.Id).ToListAsync();
                if (existing.Count > 0)
                {
                    _db.UserGroups.RemoveRange(existing);
                }

                var selected = (selectedGroups ?? Array.Empty<string>())
                    .Where(g => !string.IsNullOrWhiteSpace(g))
                    .Select(g => g.Trim())
                    .Where(g => !string.IsNullOrWhiteSpace(g))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                // Ensure every new user is at least in the default Users group.
                if (NewUser && !selected.Any(g => string.Equals(g, ModulynSystemGroupNames.Users, StringComparison.OrdinalIgnoreCase)))
                    selected.Add(ModulynSystemGroupNames.Users);

                if (selected.Count > 0)
                {
                    var groups = await _db.Groups
                        .Where(g => selected.Contains(g.Name))
                        .ToListAsync();

                    foreach (var name in selected)
                    {
                        var group = groups.FirstOrDefault(g => string.Equals(g.Name, name, StringComparison.OrdinalIgnoreCase));
                        if (group == null)
                        {
                            group = new ApplicationGroup { Name = name };
                            _db.Groups.Add(group);
                            await _db.SaveChangesAsync();
                            groups.Add(group);
                        }

                        _db.UserGroups.Add(new ApplicationUserGroup { UserId = User.Id, GroupId = group.Id });
                    }
                }

                await _db.SaveChangesAsync();
            }

            DialogService.Close(true); // Close dialog and indicate success
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"An unexpected error occurred: {ex.Message}" });
            DialogService.Close(false);
        }
    }

    private void Cancel()
    {
        DialogService.Close(false); // Close dialog without saving
    }
}