@using Microsoft.AspNetCore.Authorization
@using ModulynServer.Handlers
@using Modulyn.Server.Bl
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WebServerSettings svrSettings
@implements IDisposable

<RadzenPanelMenuItem class="item-with-icon" style="background-color:transparent" Visible="@elementVisible" Text="@NavItem.NavItemName" Path="@NavItem.Target" Image="@NavItem.Icon" @bind-Expanded="NavItem.Expanded" Click="OnItemClicked">
        @foreach (var subItem in authorizedChildren)
        {
            <NavElement NavItem="@subItem" />
        }
</RadzenPanelMenuItem>


@code {
    [Parameter, EditorRequired]
    public WebServerNavItem NavItem{ get; set; }

    private bool elementVisible = true;

    private List<WebServerNavItem> authorizedChildren = new();

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await RecomputeVisibilityAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await RecomputeVisibilityAsync();
            StateHasChanged();
        });
    }

    private async Task RecomputeVisibilityAsync()
    {
        if (svrSettings.Authentication)
        {
            elementVisible = await IsAuthorizedAsync(NavItem);
            if (elementVisible)
            {
                authorizedChildren = new();
                foreach (var subItem in NavItem.Children)
                {
                    if (await IsAuthorizedAsync(subItem))
                        authorizedChildren.Add(subItem);
                }
            }
            else
            {
                authorizedChildren = new();
            }
        }
        else
        {
            elementVisible = true;
            authorizedChildren = NavItem.Children;
        }
    }

    private async Task<bool> IsAuthorizedAsync(WebServerNavItem navItem)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // If a group is specified, it takes priority over role.
        if (!string.IsNullOrWhiteSpace(navItem.RequiredGroup))
        {
            var requirement = new ModulynGroupAuthRequirement(navItem.RequiredGroup);
            var result = await AuthorizationService.AuthorizeAsync(user, null, requirement);
            return result.Succeeded;
        }
        else
        {
            var requirement = new ModulynAuthRequirement(navItem.RequiredRole);
            var result = await AuthorizationService.AuthorizeAsync(user, null, requirement);
            return result.Succeeded;
        }
    }

    void OnItemClicked(MenuItemEventArgs args)
    {
        System.Diagnostics.Debug.WriteLine($"{args.Text} clicked");
    }
}
