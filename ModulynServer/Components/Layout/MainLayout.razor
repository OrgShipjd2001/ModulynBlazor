@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inherits LayoutComponentBase
@inject NavigationManager navMgr

<RadzenComponents/>

<div class="page">
    <div class="sidebar" style="@IconMenuCssClass">
        <NavMenu ShowIconMenu="ToggleIconMenu" />
    </div>

    <main>
        <div class="top-row px-4" style="text-align:right">
            <AuthorizeView>
                <Authorized Context="authContext">
                    <span>@authContext.User.Identity.Name</span><br />
                    <RadzenTemplateForm TItem="object" Action="/api/auth/logout" Method="Post">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Logout" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" />
                    </RadzenTemplateForm>
                </Authorized>
                <NotAuthorized>
                    <RadzenButton Text="Login" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="Login"/>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _iconMenuActive { get; set; }
    private string? IconMenuCssClass => _iconMenuActive ? "width: 80px;" : null;

    protected void ToggleIconMenu(bool iconMenuActive)
    {
        _iconMenuActive = iconMenuActive;
    }

    private async Task Login()
    {
        navMgr.NavigateTo("login");
    }
}