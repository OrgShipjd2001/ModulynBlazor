@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inherits LayoutComponentBase
@inject WebServerSettings SvrSettings
@inject NavigationManager NavigationManager

<RadzenComponents />

<div class="page">
    <div class="sidebar" style="@IconMenuCssClass">
        <NavMenu ShowIconMenu="ToggleIconMenu" />
    </div>

    <main style="width:75vw">
        <div class="top-row px-4">
            @if (SvrSettings.Authentication)
            {
                <AuthorizeView Context="auth">
                    <Authorized>
                        <div class="nav-item px-1">
                            <div class="dropdown modulyn-user-menu">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle modulyn-user-menu__button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @auth.User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end modulyn-user-menu__menu">
                                    <li>
                                        <NavLink class="dropdown-item modulyn-user-menu__item" href="Account/Security">Security</NavLink>
                                    </li>
                                    @if (!auth.User.Identity.AuthenticationType.Equals("HttpAuthHeader", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form class="modulyn-user-menu__form" action="Account/Logout" method="post">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="ReturnUrl" value="" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm modulyn-user-menu__item">Logout</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                            @if (!auth.User.Identity.AuthenticationType.Equals("HttpAuthHeader", StringComparison.OrdinalIgnoreCase))
                            {
                                
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="Account/Login">
                                <span class="btn btn-outline-primary btn-sm" aria-hidden="true">Login</span>
                            </NavLink>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>


@code {
    private bool _iconMenuActive { get; set; }
    private string? IconMenuCssClass => _iconMenuActive ? "width: 80px;" : null;

    protected void ToggleIconMenu(bool iconMenuActive)
    {
        _iconMenuActive = iconMenuActive;
    }

    private void LogoutClick()
    {
        // This is a simple way to trigger the logout action.
        // You can also use a form submission or a direct API call if needed.
        NavigationManager.NavigateTo("Account/LogoutPage", true);
    }
}