@using Microsoft.AspNetCore.Components.Web
@inject WebServerModuleManager ModuleManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Navigation.css" />
    <link rel="stylesheet" href="ModulynServer.styles.css" />

    @if (!string.IsNullOrWhiteSpace(WebServerSettings.Instance.SiteImage))
    {
        <link rel="icon" type="image/png" href="@WebServerSettings.Instance.SiteImage" />
    }
    else
    {
        <link rel="icon" type="image/png" href="ModulynBlazor.jpg" />
    }

    @foreach(IWebServerModule module in ModuleManager.GetModuleList())
    {
        <link rel="stylesheet" href="@(module.ModuleId + ".styles.css")" />
    }

    <RadzenTheme Theme="material" @rendermode="@RenderModeForPage" />
    <HeadOutlet @rendermode="@RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // This is crucial. If your RadzenPanelMenu is interactive,
    // you might need your main layout/routes to be interactive as well,
    // or at least ensure the antiforgery token is generated in a way
    // that's compatible with interactive components.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null // No interactive render mode for account pages (static SSR)
            : InteractiveServer; // Or InteractiveAuto, or simply null if you prefer selective interactivity on pages
}