<?xml version="1.0" encoding="utf-8" ?>
<WebSiteSettings>
	<WebSiteName>Modulyn Server</WebSiteName>		<!-- display name of the web site -->
	<SiteImage>modulynblazor.png</SiteImage>		<!-- url to the web site image -->
	<ShowHomeItem>true</ShowHomeItem>			<!-- turns the site default home page on or off -->
	<ModulesPath>Modules</ModulesPath>			<!-- Can be a full directory path or a subdirectory name -->
	<StartupPage></StartupPage>					<!-- Override / redirect the home page to the set page -->
	<Authentication>
		<Enabled>false</Enabled>
		<AuthSettings>
			<Provider>Windows</Provider>
			<Enabled>false</Enabled>
		</AuthSettings>
		<AuthSettings>
			<Provider>Local</Provider>
			<Enabled>false</Enabled>
			<Property name="DbType">SQLServer</Property>
			<Property name="ConnectionString">Server=HMIIntegration;Database=applicationdb;User Id=IntSvcDbUser;Password=int$svc$db$user$1;MultipleActiveResultSets=true;Encrypt=False</Property>
		</AuthSettings>
		<AuthSettings>
			<Provider>EntraId</Provider>
			<Enabled>false</Enabled>
			<Property name="ClientId"></Property>
			<Property name="TenantId"></Property>
			<Property name="ClientSecret"></Property>
			<Property name="Instance"></Property>
		</AuthSettings>
		<AuthSettings>
			<Provider>Google</Provider>
			<Enabled>false</Enabled>
			<Property name="ClientId"></Property>
			<Property name="ClientSecret"></Property>
		</AuthSettings>
	</Authentication>
</WebSiteSettings>