@page "/Account/Admin/UserManagement"
@using Microsoft.AspNetCore.Identity
@using ModulynServer2.Data

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>User Management</PageTitle>

<h3>User Management</h3>

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        @if (userRoles.ContainsKey(user.Id))
                        {
                            @foreach (var role in userRoles[user.Id])
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => ShowRoleDialog(user.Id)">Edit Roles</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(user.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showRoleDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Roles for @editUser?.UserName</h5>
                    <button type="button" class="btn-close" @onclick="CloseRoleDialog"></button>
                </div>
                <div class="modal-body">
                    @foreach (var role in allRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@role.Name"
                                   checked="@selectedRoles.Contains(role.Name)"
                                   @onchange="e => OnRoleCheckboxChanged(role.Name, e.Value is bool b && b)" />
                            <label class="form-check-label" for="@role.Name">@role.Name</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="SaveRoles">Save</button>
                    <button class="btn btn-secondary" @onclick="CloseRoleDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<ApplicationUser>? users;
    private Dictionary<string, IList<string>> userRoles = new();
    private List<IdentityRole> allRoles = new();
    private bool showRoleDialog = false;
    private ApplicationUser? editUser;
    private HashSet<string> selectedRoles = new();

    protected override async Task OnInitializedAsync()
    {
        users = UserManager.Users.ToList();
        allRoles = RoleManager.Roles.ToList();
        foreach (var user in users)
        {
            userRoles[user.Id] = await UserManager.GetRolesAsync(user);
        }
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.DeleteAsync(user);
            users = UserManager.Users.ToList();
            userRoles.Remove(userId);
            StateHasChanged();
        }
    }

    private async void ShowRoleDialog(string userId)
    {
        editUser = users?.FirstOrDefault(u => u.Id == userId);
        if (editUser != null)
        {
            selectedRoles = (await UserManager.GetRolesAsync(editUser)).ToHashSet();
            showRoleDialog = true;
            StateHasChanged();
        }
    }

    private void CloseRoleDialog()
    {
        showRoleDialog = false;
        editUser = null;
        selectedRoles.Clear();
    }

    private void OnRoleCheckboxChanged(string role, bool isChecked)
    {
        if (isChecked)
            selectedRoles.Add(role);
        else
            selectedRoles.Remove(role);
    }

    private async void SaveRoles()
    {
        if (editUser != null)
        {
            var currentRoles = await UserManager.GetRolesAsync(editUser);
            var rolesToAdd = selectedRoles.Except(currentRoles).ToList();
            var rolesToRemove = currentRoles.Except(selectedRoles).ToList();

            if (rolesToAdd.Any())
                await UserManager.AddToRolesAsync(editUser, rolesToAdd);
            if (rolesToRemove.Any())
                await UserManager.RemoveFromRolesAsync(editUser, rolesToRemove);

            userRoles[editUser.Id] = await UserManager.GetRolesAsync(editUser);
        }
        CloseRoleDialog();
        StateHasChanged();
    }
}